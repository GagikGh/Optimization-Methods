import numpy as np

Q = np.array([[5.0, 1.0], [1.0, 6.0]])
b = np.array([6.0, 7.0])
x = np.array([2.0, 2.0])
eps = 1e-3

def f(x):
    return 0.5 * (x @ Q @ x) - (b @ x)

print(f"{'k':<3} | {'x^k':<24} | {'alpha_k':<9} | {'||grad||_2':<10}")
print("-" * 75)

k = 0

while True:
    g = Q @ x - b
    grad_norm = np.linalg.norm(g)
    
    fx = f(x)

    if grad_norm < eps:
        print(f"{k:<3} | ({x[0]:.4f}, {x[1]:.4f})^T_      | {'—':<9} | {grad_norm:.4f}")
        break

    g_T_g = g @ g
    g_T_Q_g = g @ Q @ g
    alpha = g_T_g / g_T_Q_g

    print(f"{k:<3} | ({x[0]:.4f}, {x[1]:.4f})^T_      | {alpha:.4f}    | {grad_norm:.4f}")

    x = x - alpha * g
    k += 1

print("-" * 75)

final_fx = f(x)

print(f"\nՕպտիմալ լուծում: x^* = ({x[0]:.4f}, {x[1]:.4f})^T")
print(f"Ֆունկցիայի արժեք օպտիմալ կետում: f(x^*) = {final_fx:.4f}")
